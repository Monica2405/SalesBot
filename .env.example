# Copy to .env and fill in. NEVER commit .env. Values here must stay empty.
# Used by apps/api and apps/voice-agent (server side only).
# The admin app has its own apps/admin/.env.example with VITE_ keys only.

# ---- App ----
# local | staging | production
APP_ENV=
# Random string for signing app-level tokens (python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=

# ---- Supabase ----
# Local: printed by `supabase start` (http://127.0.0.1:54321)
SUPABASE_URL=
# Public anon key. Safe in the browser only because RLS is on for every table.
SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS. Never put this in apps/admin or any VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string. Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_URL=
# Legacy HS256 JWT secret used to verify owner tokens (projects on asymmetric keys use JWKS instead)
SUPABASE_JWT_SECRET=

# ---- Voice providers (STT / LLM / TTS) ----
# Sarvam AI key (Saaras STT, Sarvam-30B LLM, Bulbul TTS). Paid.
SARVAM_API_KEY=
# mock | sarvam
STT_PROVIDER=
# mock | sarvam
LLM_PROVIDER=
# mock | sarvam
TTS_PROVIDER=

# ---- Client intake (docs/INTAKE_CONTRACT.md) ----
# hmac_webhook (default)
INTAKE_ADAPTER=
# Shared secret for signing intake requests, >= 32 chars. Share it with the registration form's
# owner over a secure channel. python -c "import secrets; print(secrets.token_urlsafe(48))"
INTAKE_HMAC_SECRET=

# ---- Telephony (OPEN DECISION: Plivo vs Exotel, see docs/DECISIONS.md) ----
# mock | plivo | exotel
TELEPHONY_PROVIDER=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=

# ---- Google Calendar (OAuth, per business) ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# e.g. http://localhost:8000/integrations/google/callback
GOOGLE_OAUTH_REDIRECT_URI=

# ---- WhatsApp (OPEN DECISION: provider, see docs/DECISIONS.md) ----
# mock | (provider TBD)
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ---- CRM ----
# true | false (default false). When false the CRM adapter is a no-op.
HUBSPOT_ENABLED=
HUBSPOT_ACCESS_TOKEN=

# ---- Limits and cost controls ----
# Hard cap on a single call's length, in seconds (e.g. 600)
CALL_MAX_SECONDS=
# Monthly minutes per business before calls go to the callback fallback (e.g. 500)
DEFAULT_BUSINESS_USAGE_CAP_MINUTES=
